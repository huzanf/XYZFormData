# Copy this file to .env and fill in your real values.
# This app connects READ-ONLY to your WordPress MySQL database to read
# Gravity Forms entries. Do not commit the real .env file.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wordpress
DB_USER=wp_readonly
DB_PASS=
DB_TABLE_PREFIX=wp_

APP_TITLE=XYZ Form Data Portal
APP_PER_PAGE=50
APP_MAX_EXPORT_ROWS=20000

# The portal's OWN database (separate from WordPress) — holds user
# accounts, one-time login codes, and the login audit log. Create a new,
# empty database for this (e.g. in cPanel's "MySQL Databases" tool) and
# run portal_schema.sql against it once. See README.md for the full setup.
PORTAL_DB_HOST=127.0.0.1
PORTAL_DB_PORT=3306
PORTAL_DB_NAME=
PORTAL_DB_USER=
PORTAL_DB_PASS=

# "From" address for login-code emails. MUST be a real address on YOUR
# domain (e.g. no-reply@xyzfoundation.net) — an address on an unrelated
# domain is very likely to be marked as spam or rejected outright, since
# that's what SPF/DKIM checks look at.
MAIL_FROM=
