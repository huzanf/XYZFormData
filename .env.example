# Copy this file to .env and fill in your real values.
# This app connects READ-ONLY to your WordPress MySQL database to read
# Gravity Forms entries. Do not commit the real .env file.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wordpress
DB_USER=wp_readonly
DB_PASS=
DB_TABLE_PREFIX=wp_

APP_TITLE=XYZ Form Data Dashboard
APP_PER_PAGE=50
