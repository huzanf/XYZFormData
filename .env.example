# Copy this file to .env and fill in your real values.
# This app connects READ-ONLY to your WordPress MySQL database to read
# Gravity Forms entries. Do not commit the real .env file.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wordpress
DB_USER=wp_readonly
DB_PASS=
DB_TABLE_PREFIX=wp_

APP_TITLE=XYZ Form Data Portal
APP_PER_PAGE=50
APP_MAX_EXPORT_ROWS=20000

# Password that protects the whole portal. Generate a hash with:
#   php -r "echo password_hash('your-password-here', PASSWORD_DEFAULT), PHP_EOL;"
# Leave blank to disable login (NOT recommended — this portal can display
# and export personal/financial data).
PORTAL_PASSWORD_HASH=
