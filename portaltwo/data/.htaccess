# Block all direct web access to this folder. It holds views.json (the
# admin-configured forms/views store), which should never be fetched
# directly over the web.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
